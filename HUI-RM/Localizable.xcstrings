    },
    "If the fader motor keeps buzzing, press Click to briefly move the fader and return it to its position. This may stop the buzzing. Use with playback stopped and your hand off the fader." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the fader motor keeps buzzing, press Click to briefly move the fader and return it to its position. This may stop the buzzing. Use with playback stopped and your hand off the fader."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フェーダーのモーターが唸り続ける時に、メトロノームボタンを押してください。フェーダーを少し動かして元に戻し、唸りの解消を試みます。停止中、フェーダーから手を離して使用してください。"
          }
        }
      }
    },
