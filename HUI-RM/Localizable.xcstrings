    "Adds the missing Solo button release signal so Pro Tools does not treat the button as held down. This prevents Solo from becoming stuck on when using Shift+S." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the missing Solo button release signal so Pro Tools does not treat the button as held down. This prevents Solo from becoming stuck on when using Shift+S."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soloボタンを離しても、Pro Tools側に押された状態が残る問題を補正します。不足している「ボタンを離した」信号を補い、Shift＋SでSoloを解除できなくなる症状を防ぎます。"
          }
        }
      }
    },
